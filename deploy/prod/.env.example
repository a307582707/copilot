# Copy to .env, generate strong secrets, and protect it with chmod 600.
AUTH_SECRET=replace-with-at-least-32-random-characters
CRED_ENC_KEY=replace-with-a-fernet-key
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-admin-password
COOKIE_SECURE=1

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=codesprite
MYSQL_USER=codesprite
MYSQL_PASSWORD=replace-with-a-strong-database-password
APP_PORT=18030
APP_DATA_DIR=./data/app
MYSQL_DATA_DIR=./data/mysql
TZ=UTC

OLLAMA_BASE_URL=http://host.docker.internal:11434
