# Copy to .env and replace every generated value before starting Compose.
AUTH_SECRET=replace-with-at-least-32-random-characters
CRED_ENC_KEY=replace-with-a-fernet-key
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-password
COOKIE_SECURE=0

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=codesprite
MYSQL_USER=codesprite
MYSQL_PASSWORD=replace-with-a-strong-database-password
TZ=UTC

# Ollama on the Docker host. Replace with any compatible endpoint if needed.
OLLAMA_BASE_URL=http://host.docker.internal:11434
