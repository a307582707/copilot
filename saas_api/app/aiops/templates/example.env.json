{
  "env": "staging",
  "region": "cn-shenzhen",
  "owner_group": "platform-sre",
  "change_window": {
    "timezone": "Asia/Shanghai",
    "default_observe_minutes": 15
  },
  "flink": {
    "product": "ververica",
    "openapi_version": "2022-07-18",
    "workspace": "<REPLACE_WORKSPACE_ID>",
    "namespace": "<REPLACE_NAMESPACE>",
    "endpoint_type": "public"
  },
  "dlf": {
    "catalog": "<REPLACE_DLF_CATALOG_NAME_OR_ID>",
    "openapi_version_prefer": "2020-07-10",
    "endpoint": "<REPLACE_DLF_ENDPOINT>"
  },
  "starrocks": {
    "fe_host": "<REPLACE_SR_FE_HOST>",
    "mysql_port": 9030,
    "http_port": 8030,
    "warehouse": "default_warehouse"
  },
  "dataworks": {
    "product": "dataworks-public",
    "project_id": "<REPLACE_DATAWORKS_PROJECT_ID>",
    "project_identifier": "<REPLACE_DATAWORKS_PROJECT_IDENTIFIER>"
  }
}
