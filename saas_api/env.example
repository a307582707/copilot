AUTH_SECRET=replace-with-a-stable-random-secret
# Accepts true/false or 1/0 (Compose examples use 0/1).
COOKIE_SECURE=0
SESSION_COOKIE_NAME=codesprite_session

# Initial admin bootstrap (either pair works)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=replace-with-a-strong-password
# Compose aliases also accepted:
# ADMIN_USER=admin
# ADMIN_PASS=replace-with-a-strong-password

# Encrypt stored SSH / cloud credentials (Fernet urlsafe base64).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_ENC_KEY=replace-with-a-fernet-key

# Database
# Production: set DB_REQUIRE_MYSQL=true and provide DB_DSN.
DB_REQUIRE_MYSQL=false
# SQLite fallback example (local dev / rollback only):
DB_PATH=./data/app.db
# MySQL primary-store example:
# DB_DSN=mysql+pymysql://codesprite:strong_password@codesprite-mysql:3306/codesprite?charset=utf8mb4

# Controlled free beta
CODESPRITE_BETA_MODE=true
# Temporary alias still accepted: COVIXA_BETA_MODE
BETA_INITIAL_CREDIT_CENTS=3000
BETA_USER_DAILY_BUDGET_CENTS=500
BETA_USER_MONTHLY_BUDGET_CENTS=3000
BETA_SITE_DAILY_BUDGET_CENTS=5000
BETA_MAX_OUTPUT_CHARS=8000
BETA_MAX_CONCURRENT_PER_USER=1
CHAT_REQUIRE_AUTH=true
BILLING_ENABLED=true
# Character-based beta cost model used to burn free quota, not real cash.
BILLING_PRICING_JSON={"default":{"prompt_per_1k_chars_cents":2,"completion_per_1k_chars_cents":6,"min_charge_cents":1}}

# Session / cache strategy
# - Current default session backend is signed cookie (stateless).
# - Do not use Redis as the source of truth for users/bindings/orders.
# - Redis/user_sessions are optional later only for revocation / rate-limit / short TTL cache.

# SMS login
AUTH_SMS_LOGIN_ENABLED=true
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_TEMPLATE_LOGIN=
ALIYUN_SMS_TEMPLATE_BIND_PHONE=
ALIYUN_SMS_TEMPLATE_RESET_PASSWORD=

# WeChat web QR login
AUTH_WECHAT_LOGIN_ENABLED=false
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=https://codesprite.example.com/api/auth/wechat/web/callback
AUTH_LOGIN_CHALLENGE_TTL_SEC=300
